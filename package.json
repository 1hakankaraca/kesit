{
  "name": "kesit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kesit — Kick yayıncıları için klip stüdyosu: tara, kes, kaydet, işle, paylaş",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n sunucu,arayuz -c yellow,blue \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "hls.js": "^1.7.3",
    "motion": "^14.2.0",
    "multer": "^2.4.0",
    "pusher-js": "^8.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
