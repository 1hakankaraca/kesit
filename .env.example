# ── Kesit ────────────────────────────────────────────────────────────────
PORT=3002
# Tarayıcıdan erişilen adres (OAuth dönüşü ve köken denetimi için)
BASE_URL=http://localhost:5174
# Oturum çerezi imzası ve Zernio anahtarı şifrelemesi. Üretimde en az 32 karakter ZORUNLU.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KESIT_SECRET=
# Veritabanı, klipler, kayıtlar ve arşiv görselleri bu dizinde durur (kalıcı disk olmalı)
DATA_DIR=data

# ── Nöbetçi ──────────────────────────────────────────────────────────────
# Takip edilen kanalın yoklanma aralığı (en az 20 sn)
AUTOPILOT_POLL_SECONDS=45

# ── Klip motoru ──────────────────────────────────────────────────────────
# Aynı anda işlenecek klip sayısı (en fazla 4)
CLIP_WORKERS=
VOD_SCAN_WORKERS=1
RECORDER_MAX_MINUTES=240
INTRO_MAX_SECONDS=60
INTRO_MAX_MB=200
# Varsa BullMQ kullanılır (çok süreçli); yoksa süreç içi kuyruk
REDIS_URL=

# Altyazı: arayüzde Ayarlar'dan yönetilir (model indirme / ElevenLabs anahtarı).
WHISPER_BIN=whisper-cli

# Kalite kontrolü ve viral skor için görsel model (isteğe bağlı; yoksa sezgisel puan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Kullanıcı kendi Zernio hesabını bağlamazsa düşülecek ortak anahtar (opsiyonel)
ZERNIO_API_KEY=
